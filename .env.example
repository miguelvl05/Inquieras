# ============================================================
#  Copien este archivo como .env y llenen los valores reales.
#  El .env NUNCA se sube a GitHub (está en .gitignore).
# ============================================================

# --- Base de datos (Railway, servicio MySQL) ---
# Opción A: una sola URL. En Railway: servicio MySQL > Variables > MYSQL_PUBLIC_URL
# (usen la PÚBLICA, la interna "mysql.railway.internal" solo funciona dentro de Railway)
# Si DATABASE_URL tiene valor, se ignoran las variables DB_* de abajo.
DATABASE_URL=

# Opción B: datos separados (en Railway > Connect > Public Network)
DB_HOST=xxxxx.proxy.rlwy.net
DB_PORT=12345
DB_USER=root
DB_PASSWORD=cambia_esto
DB_NAME=railway
# Pongan true solo si la conexión exige SSL
DB_SSL=false

# Solo si usan el contenedor MySQL local (comentado en docker-compose)
DB_ROOT_PASSWORD=

# --- Django ---
# Generar una con: python -c "import secrets; print(secrets.token_urlsafe(50))"
DJANGO_SECRET_KEY=cambia_esto_por_una_clave_larga
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,backend
CORS_ALLOWED_ORIGINS=http://localhost:5173

# --- Autenticación ---
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
JWT_KEY=cambia_esto

# --- Frontend ---
# OJO: es localhost y no "backend", porque quien llama a la API es tu navegador, no el contenedor.
VITE_API_URL=http://localhost:8000
